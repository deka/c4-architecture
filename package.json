{
  "name": "c4-architecture",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Runtime that reads a C4 model in JSON and renders SVG diagrams in a self-contained HTML page.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "cucumber-js",
    "typecheck": "tsc --noEmit",
    "check:plugin-version": "node scripts/check-plugin-version.ts --worktree",
    "font-metrics": "node scripts/font-metrics.ts",
    "render": "node src/cli.ts render",
    "examples": "node scripts/render-examples.ts",
    "approve": "node scripts/approve-renderings.ts",
    "docs": "eleventy",
    "docs:serve": "eleventy --serve"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
