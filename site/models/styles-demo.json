{
  "$schema": "../../schema/c4.schema.json",
  "version": 1,
  "name": "Styles",
  "model": {
    "people": [
      {
        "id": "ops",
        "name": "Operator",
        "description": "Runs the platform"
      }
    ],
    "softwareSystems": [
      {
        "id": "platform",
        "name": "Platform",
        "description": "The system being designed",
        "containers": [
          {
            "id": "api",
            "name": "API",
            "description": "Public API",
            "technology": "Kotlin"
          },
          {
            "id": "legacy",
            "name": "Legacy batch",
            "description": "Being decommissioned",
            "technology": "COBOL",
            "tags": [
              "Deprecated"
            ]
          },
          {
            "id": "queue",
            "name": "Event bus",
            "description": "Domain events",
            "technology": "Kafka",
            "tags": [
              "Queue"
            ]
          }
        ]
      },
      {
        "id": "crm",
        "name": "CRM",
        "description": "Customer records",
