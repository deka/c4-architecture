      },
      {
        "from": "api",
        "to": "queue",
        "description": "Publishes events to",
        "technology": "Kafka",
        "tags": [
          "Async"
        ]
      },
      {
        "from": "legacy",
        "to": "queue",
        "description": "Publishes events to",
        "technology": "Kafka",
        "tags": [
          "Async"
        ]
      },
      {
        "from": "api",
        "to": "crm",
        "description": "Reads customers from",
        "technology": "HTTPS/JSON"
      }
    ]
  },
  "views": [
    {
      "type": "container",
      "key": "styled",
      "scope": "platform"
    }
  ],
  "styles": {
    "elements": [
      {
        "tag": "Queue",
        "shape": "pipe"
      },
      {
        "tag": "Deprecated",
        "border": "dashed",
        "opacity": 60,
        "background": "#fbe9e7",
        "stroke": "#b4553f"
      }
    ],
    "relationships": [
      {
        "tag": "Async",
        "style": "dashed",
        "color": "#b4553f"
      }
    ]
  }
