<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle %}{% if title and page.url != "/" %}{{ title }} · {% endif %}C4 Architecture{% endset %}
{%- set pageDescription = summary or 'Describe a C4 model in JSON, or design it with Claude, and get clean diagrams in a single HTML file.' %}
{#- Social previews (LinkedIn, Slack, X…) need absolute URLs and a raster image. #}
{%- set siteUrl = "https://deka.github.io/c4-architecture" %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="C4 Architecture">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
<meta property="og:image" content="{{ siteUrl }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="C4 Architecture: C4 diagrams and ADRs as code">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/assets/site.css">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><img src="/assets/favicon.svg" alt="" width="22" height="22"> C4 Architecture</a>
  <nav class="toplinks">
    <a href="/tutorial/"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5C6.6 2.6 4.6 2.2 2 2.5v10c2.6-.3 4.6.1 6 1 1.4-.9 3.4-1.3 6-1v-10c-2.6-.3-4.6.1-6 1Zm0 0v10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>Tutorial</a>
    <a href="/schema/"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 2.5c-1.5 0-2 .6-2 2v1.6c0 1-.5 1.6-1.5 1.9 1 .3 1.5.9 1.5 1.9v1.6c0 1.4.5 2 2 2m5-11c1.5 0 2 .6 2 2v1.6c0 1 .5 1.6 1.5 1.9-1 .3-1.5.9-1.5 1.9v1.6c0 1.4-.5 2-2 2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>Schema</a>
    <a href="https://github.com/deka/c4-architecture"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>GitHub</a>
  </nav>
</header>
<div class="shell">
  <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Show navigation">
  <label for="menu-toggle" class="menu-button">Menu</label>
  <aside class="sidebar">
    {%- for group in nav %}
    <p class="nav-section">{{ group.section }}</p>
    <ul>
      {%- for item in group.pages %}
      <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
      {%- endfor %}
    </ul>
    {%- endfor %}
  </aside>
  <main class="content{% if wide %} wide{% endif %}">
    {%- if page.url != "/" %}<h1>{{ title }}</h1>{% endif %}
    {{ content | safe }}
    <footer class="pagefoot">
      <a href="{{ page.inputPath | replace('./', '') | githubUrl }}">Edit this page</a>
      <span>The <a href="https://c4model.com/">C4 model</a> was created by <a href="https://simonbrown.je/">Simon Brown</a>. This is an independent project, not affiliated with c4model.com or Structurizr. Apache 2.0.</span>
    </footer>
  </main>
</div>
</body>
</html>
